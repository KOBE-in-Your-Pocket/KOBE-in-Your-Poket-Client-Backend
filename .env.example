# PostgreSQL (compose.yaml で使用)
POSTGRES_DB=kobe
POSTGRES_USER=kobe
POSTGRES_PASSWORD=kobe

# アプリケーション (ローカル実行時の上書き用)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kobe
SPRING_DATASOURCE_USERNAME=kobe
SPRING_DATASOURCE_PASSWORD=kobe
SERVER_PORT=9090

# ---------------------------------------------------------------------------
# Supabase（Phase 0 / #15）
# Project Settings → API から取得。実値は .env にだけ書く（コミット禁止）。
# Client には出さない。service_role / JWT secret は backend 専用。
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# DB 接続（0.4 で確認）。EC2 が IPv4 のみの場合は Supavisor session mode :5432。
# transaction mode :6543 は使わない（JPA / Flyway と相性が悪い）。
# SUPABASE_DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=your-database-password
# Supabase 接続時のみ
# SPRING_PROFILES_ACTIVE=supabase
# SPRING_FLYWAY_BASELINE_ON_MIGRATE=true

# ---------------------------------------------------------------------------
# 画像アップロード（S3 / #86）。バケット・IAM は infrastructure/provision-media-s3.sh で用意。
# AWS 認証情報はここに書かない（SDK 既定チェーン = EC2 の IAM ロール kobe-backend-ec2-role）。
# 未設定でも起動はするが、初回アップロードで失敗する。
# ---------------------------------------------------------------------------
MEDIA_S3_BUCKET=kobe-in-your-pocket-media
MEDIA_S3_REGION=ap-northeast-1
# CloudFront を使う場合のみ設定（空なら S3 仮想ホスト形式 URL を返す）
# MEDIA_S3_PUBLIC_BASE_URL=https://xxxx.cloudfront.net
